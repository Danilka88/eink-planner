{
  "$description": "РИТУАЛ — 1-bit friendly e-ink palette. Every colour is a light/dark pair, AA checked.",
  "color": {
    "surface": {
      "$type": "color",
      "$value": {
        "light": "#ffffff",
        "dark": "#121212"
      }
    },
    "surface.muted": {
      "$type": "color",
      "$value": {
        "light": "#ededed",
        "dark": "#1f1f1f"
      }
    },
    "text": {
      "$type": "color",
      "$value": {
        "light": "#000000",
        "dark": "#f5f5f5"
      }
    },
    "text.muted": {
      "$type": "color",
      "$value": {
        "light": "#4a4a4a",
        "dark": "#b8b8b8"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "light": "#000000",
        "dark": "#ffffff"
      }
    },
    "onAccent": {
      "$type": "color",
      "$value": {
        "light": "#ffffff",
        "dark": "#121212"
      }
    },
    "border": {
      "$type": "color",
      "$value": {
        "light": "#000000",
        "dark": "#e6e6e6"
      }
    },
    "border.muted": {
      "$type": "color",
      "$value": {
        "light": "#8a8a8a",
        "dark": "#6a6a6a"
      }
    },
    "danger": {
      "$type": "color",
      "$value": {
        "light": "#8a1010",
        "dark": "#ff9a9a"
      }
    },
    "success": {
      "$type": "color",
      "$value": {
        "light": "#0b5c2e",
        "dark": "#7fe0a8"
      }
    },
    "warn": {
      "$type": "color",
      "$value": {
        "light": "#6b3d00",
        "dark": "#ffc46b"
      }
    },
    "missed.fill": {
      "$type": "color",
      "$value": {
        "light": "#d4d4d4",
        "dark": "#2e2e2e"
      }
    },
    "missed.text": {
      "$type": "color",
      "$value": {
        "light": "#000000",
        "dark": "#f5f5f5"
      }
    },
    "debt.fill": {
      "$type": "color",
      "$value": {
        "light": "#bcbcbc",
        "dark": "#3a3a3a"
      }
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', sans-serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "ui-monospace, 'Roboto Mono', 'SFMono-Regular', monospace"
    }
  },
  "size": {
    "small": {
      "$type": "dimension",
      "$value": "15px"
    },
    "body": {
      "$type": "dimension",
      "$value": "18px"
    },
    "h3": {
      "$type": "dimension",
      "$value": "22px"
    },
    "h2": {
      "$type": "dimension",
      "$value": "28px"
    },
    "h1": {
      "$type": "dimension",
      "$value": "40px"
    },
    "clock": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "20px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "2px"
    },
    "md": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "motion": {
    "fast": {
      "$type": "duration",
      "$value": "0ms"
    },
    "base": {
      "$type": "duration",
      "$value": "0ms"
    }
  },
  "stroke": {
    "hair": {
      "$type": "dimension",
      "$value": "1px"
    },
    "strong": {
      "$type": "dimension",
      "$value": "3px"
    },
    "heavy": {
      "$type": "dimension",
      "$value": "5px"
    }
  }
}
